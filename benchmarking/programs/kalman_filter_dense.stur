symbols: N, X

R1(i, l) := A(i, k) * P0(k, l)
R2(i, j) := R1(i, l) * A(j, l)
P1(i, j) := R2(i, j) + Q(i, j)

A:D(i, k)  := (0 <= i < N) * (0 <= k < N)
P0:D(k, l) := (0 <= k < N) * (0 <= l < N)
Q:D(i, j)  := (0 <= i < N) * (0 <= j < N)
R1:D(i, l) := (0 <= i < N) * (0 <= l < N)
R2:D(i, j) := (0 <= i < N) * (0 <= j < N)
P1:D(i, j) := (0 <= i < N) * (0 <= j < N)

A:U(i, k)  := (i - X <= k) * (k <= i + X)
P0:U(k, l) := (k - X <= l) * (l <= k + X)
Q:U(i, j)  := (i - X <= j) * (j <= i + X)

@preprocess_start
@preprocess_end
