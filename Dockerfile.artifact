FROM ubuntu:24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Base build dependencies
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        lld \
        cmake \
        ninja-build \
        git \
        wget \
        ca-certificates \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang
ENV CXX=clang++

# ---------------------------------------------------------------------------
# Build MLIR
# ---------------------------------------------------------------------------
FROM base AS mlir-builder

RUN git init /llvm-project \
    && cd /llvm-project \
    && git remote add origin https://github.com/llvm/llvm-project.git \
    && git fetch --depth 1 origin 104e82b75defd23ade610a5a75cd95244638ec0b \
    && git checkout FETCH_HEAD

RUN cmake -G Ninja \
        -S /llvm-project/llvm \
        -B /llvm-project/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/mlir \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DLLVM_ENABLE_PROJECTS="mlir" \
        -DLLVM_TARGETS_TO_BUILD="Native" \
        -DLLVM_ENABLE_ASSERTIONS=ON \
        -DLLVM_INSTALL_UTILS=ON \
    && ninja -C /llvm-project/build install \
    && rm -rf /llvm-project

# ---------------------------------------------------------------------------
# Build BPA
# ---------------------------------------------------------------------------
FROM base AS bpa-builder

COPY --from=mlir-builder /opt/mlir /opt/mlir

RUN git clone https://github.com/seliayeu/algebraic-structure-analysis /app/bpa \
    && cd /app/bpa 

RUN cmake -G Ninja \
        -S /app/bpa \
        -B /app/bpa/build \
        -DENABLE_BENCHMARKING=1 \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DMLIR_DIR=/opt/mlir/lib/cmake/mlir \
    && ninja -C /app/bpa/build

# ---------------------------------------------------------------------------
# Runtime image
# ---------------------------------------------------------------------------
FROM base AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang \
        libstdc++-14-dev \
        time \
        libnss3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libasound2t64 \
        libpango-1.0-0 \
        libcairo2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=mlir-builder /opt/mlir /opt/mlir
COPY --from=bpa-builder  /app/bpa  /app/bpa

ENV PATH="/opt/mlir/bin:$PATH"
ENV MLIR_LIB_DIR=/opt/mlir/lib

# ---------------------------------------------------------------------------
# Python environment
# ---------------------------------------------------------------------------
RUN python3 -m venv /venv \
    && /venv/bin/pip install --upgrade pip \
    && /venv/bin/pip install kaleido \
    && /venv/bin/pip install -r /app/bpa/benchmarking/scripts/requirements.txt \
    && /venv/bin/kaleido_get_chrome

ENV PATH="/venv/bin:/opt/mlir/bin:$PATH"
# ---------------------------------------------------------------------------
# Runtime env
# ---------------------------------------------------------------------------
ENV BUILD_PATH=/app/bpa/build

WORKDIR /app/bpa

ENTRYPOINT ["python3", "-u", "benchmarking/scripts/artifact.py"]
CMD []
